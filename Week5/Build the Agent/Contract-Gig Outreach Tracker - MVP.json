    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst draftText = items[0].json.choices[0].message.content;\nconst threadId = $('Get One Application Thread').first().json.threadId;\nreturn [{ json: { draftText, threadId } }];"
      },
