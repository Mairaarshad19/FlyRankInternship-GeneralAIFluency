        "jsonBody": "={{ JSON.stringify({\n  model: \"inclusionai/ling-3.0-tiny:free\",\n  messages: [\n    {\n      role: \"user\",\n      content: \"You are drafting a short follow-up email for a contract job application. Voice: direct, honest, no fluff, matter-of-fact. Never inflate or use corporate filler.\\n\\nSubject: \" + $('Get One Application Thread').item.json.subject + \"\\n\\nThread snippet: \" + $('Get One Application Thread').item.json.snippet + \"\\n\\nWrite a 3-4 sentence follow-up email checking in on the application status. Return ONLY the email body text, nothing else.\"\n    }\n  ]\n}) }}",
