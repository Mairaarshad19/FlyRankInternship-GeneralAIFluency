PORT=3000

# Any random string works — used to sign login tokens
JWT_SECRET=change-this-to-something-random

# Optional: Google Gemini API key (free tier) for AI task prioritization.
# App works fine without it — falls back to sorting by due date.
GEMINI_API_KEY=

# Optional: Gmail account for sending the weekly PDF report by email.
# Use a Gmail "App Password", not your real password.
# App works fine without it — it just logs what would've been sent.
SMTP_USER=
SMTP_PASS=
